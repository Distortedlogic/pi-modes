{
  "name": "pi-just-answer",
  "version": "0.2.0",
  "private": true,
  "description": "A pi extension that loads package, global, and project prompt modes from YAML.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Distortedlogic/pi-just-answer.git"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "modes": [
      "./AGENT_MODES.yml"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.1 <1",
    "@earendil-works/pi-tui": ">=0.85.1 <1"
  },
  "dependencies": {
    "yaml": "2.9.0"
  }
}
