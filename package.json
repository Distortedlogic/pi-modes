{
	"name": "pi-modes",
	"version": "0.3.6",
	"private": true,
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Distortedlogic/pi-modes.git"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"check": "npm run typecheck && npm run lint && npm test",
		"format": "biome check --write .",
		"lint": "biome check .",
		"test": "node --import tsx --test test/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"files": [
		"agents.ts",
		"src",
		"AGENTS.yml",
		"README.md",
		"skills"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "0.87.1",
		"@earendil-works/pi-tui": "0.87.1",
		"typebox": "*"
	},
	"dependencies": {
		"pi-agents-yaml": "github:Distortedlogic/pi-agents-yaml#f37144ad06e205ed5baad8227edf5771578cc31b"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@earendil-works/pi-coding-agent": "0.87.1",
		"@earendil-works/pi-tui": "0.87.1",
		"@types/node": "22.20.4",
		"tsx": "4.23.15",
		"typebox": "1.3.34",
		"typescript": "7.0.2"
	}
}
